# ------------------------------------------------------------------
#                          SPEX ROVER 2026
# ------------------------------------------------------------------
# Reference unit for the rover Pi (user "rover").
# For any other machine, run ./auto_boot/setup.sh --install-service
# to generate and install a unit with the correct user and paths.
# ------------------------------------------------------------------
[Unit]
Description=SPEX rover basestation
After=network-online.target graphical.target
Wants=network-online.target graphical.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=rover
Group=rover
Restart=on-failure
RestartSec=10
TimeoutStopSec=10
Environment=HOME=/home/rover
Environment=PYTHONUNBUFFERED=1
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/rover/.Xauthority
Environment=XDG_RUNTIME_DIR=/run/user/%U
WorkingDirectory=/home/rover/rovers-basestation
ExecStart=/bin/bash /home/rover/rovers-basestation/auto_boot/auto_boot.sh

[Install]
WantedBy=multi-user.target